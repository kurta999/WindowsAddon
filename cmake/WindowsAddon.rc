#include <wx/msw/wx.rc>
#include "Resource.h"
#include "commitid.h"

_a ICON "../WindowsAddon.ico"
aaaa ICON "../WindowsAddon.ico"

VS_VERSION_INFO VERSIONINFO
 PRODUCTVERSION VER_PRODUCT_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VER_VER_DEBUG
 FILEOS VER_FILEOS
 FILETYPE VER_FILETYPE
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "WindowsAddon\0"
            VALUE "LegalCopyright",   "Copyright (C) 2021 kurta999\0"
            VALUE "OriginalFilename", "WindowsAddon.exe\0"
            VALUE "ProductName",      "WindowsAddon\0"
            VALUE "ProductVersion",   COMMIT_TAG "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
